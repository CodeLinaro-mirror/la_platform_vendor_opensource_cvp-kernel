load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

package(
    default_visibility = [
      "//visibility:public"],
)

ddk_headers(
    name = "eva_drivers_configs",
    hdrs  =  [
      "config/waipioevaconf.h"
    ],
    includes = ["config"]
)
ddk_headers(
    name = "uapi_headers",
    hdrs = glob([
      "include/uapi/eva/media/*.h",
    ]),
    includes = ["include/uapi/eva"]
)
ddk_headers(
    name = "msm_headers",
    hdrs = glob([
      "msm/cvp/*.h",
    ]),
    includes = ["msm","msm/eva"]
)

ddk_headers(
    name = "eva_drivers_headers",
    hdrs = [":eva_drivers_configs", ":uapi_headers", ":msm_headers"]
)

load(":lahaina.bzl", "define_lahaina")
define_lahaina()


